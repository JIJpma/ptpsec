# SPDX-License-Identifier: BSD-3-Clause
# In-tree DPDK example fragment. To build this way, copy the mitm-delay folder
# into dpdk/examples/ and add 'mitm-delay' to dpdk/examples/meson.build, then
# rebuild DPDK. The resulting binary is dpdk-mitm-delay.
#
# For most setups the standalone Makefile (`make`) against an installed DPDK is
# simpler and needs no DPDK source tree.

allow_experimental_apis = true
sources = files(
        'mitm_delay.c',
)
